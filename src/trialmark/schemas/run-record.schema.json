{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/peshwar9/trialmark/schemas/run-record.schema.json",
  "title": "Trialmark run record",
  "description": "Everything needed to repeat a run and check its result. Hashes start with jcs-sha256: (canonical JSON, RFC 8785) or, in records written before Trialmark 0.3, sha256:.",
  "type": "object",
  "required": ["test_set", "pass_mark", "pass_mark_hash", "pass_mark_set_at", "models", "repeats"],
  "properties": {
    "trialmark_version": { "type": "string" },
    "run_id": { "type": "string" },
    "test_set": {
      "type": "object",
      "required": ["name", "version", "hash"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "hash": { "type": "string", "pattern": "^(jcs-)?sha256:[0-9a-f]{64}$" }
      }
    },
    "pass_mark": { "$ref": "passmark.schema.json" },
    "pass_mark_hash": { "type": "string", "pattern": "^(jcs-)?sha256:[0-9a-f]{64}$" },
    "pass_mark_set_at": { "type": "string", "description": "When the pass mark was fixed, in ISO 8601 with a time zone." },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string" },
          "provider": { "type": "string" },
          "runner": { "type": "string" },
          "settings": { "type": "object" }
        }
      }
    },
    "repeats": { "type": "integer", "minimum": 1 },
    "judge": { "type": ["object", "null"] },
    "environment": { "type": "object" },
    "plugins": {
      "type": "object",
      "additionalProperties": { "type": "object", "additionalProperties": { "type": "string" } }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["model", "repeat", "case_id", "metrics"],
        "properties": {
          "model": { "type": "string" },
          "repeat": { "type": "integer", "minimum": 0 },
          "case_id": { "type": "string" },
          "metrics": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 } },
          "tags": { "type": "array", "items": { "type": "string" } },
          "output": {},
          "cost_usd": { "type": "number", "minimum": 0 },
          "latency_ms": { "type": "integer", "minimum": 0 },
          "input_tokens": { "type": "integer", "minimum": 0 },
          "output_tokens": { "type": "integer", "minimum": 0 },
          "error": { "type": ["string", "null"] },
          "note": { "type": "string" }
        }
      }
    }
  }
}
