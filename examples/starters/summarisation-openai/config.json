  "repeats": 3,
  "concurrency": 4,
  "models": [
    {
      "id": "gpt-4o-mini",
      "runner": "openai",
      "settings": {
        "system": "You write short, accurate summaries for a busy chief executive.",
        "pricing": {
          "input": 0.15,
          "output": 0.6,
          "cache_read": 0.075
        }
      }
    },
    {
      "id": "gpt-5.6-sol",
      "runner": "openai",
      "settings": {
        "system": "You write short, accurate summaries for a busy chief executive.",
        "pricing": {
          "input": 4.0,
          "output": 20.0,
          "cache_read": 0.4
