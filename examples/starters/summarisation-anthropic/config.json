{
  "test_set": "notes.json",
  "pass_mark": {
    "metric": "checklist_met",
    "tolerance_points": 5,
    "choose": "cheapest"
  },
  "repeats": 3,
  "concurrency": 4,
  "models": [
    {
      "id": "claude-haiku-5-5",
      "runner": "anthropic",
      "settings": {
        "system": "You write short, accurate summaries for a busy chief executive.",
        "pricing": {
          "input": 0.1,
          "output": 0.5
        }
      }
    },
    {
      "id": "claude-sonnet-5-5",
      "runner": "anthropic",
      "settings": {
        "system": "You write short, accurate summaries for a busy chief executive.",
        "pricing": {
          "input": 2.0,
          "output": 10.0,
          "cache_read": 0.2,
          "cache_write": 2.5
        }
      }
    }
  ],
  "scorers": [
    {
      "name": "checklist",
      "options": {
        "model": "claude-opus-5-5",
        "pricing": {
          "input": 4.0,
          "output": 20.0,
          "cache_read": 0.2,
          "cache_write": 5.0
        },
        "checklist": [
          "Is under 120 words",
          "States nothing that is not in the notes or email",
          "Is written in plain English"
        ]
      }
    }
  ],
  "environment": {
    "starter": "summarisation-anthropic",
    "prices_as_of": "5 November 2026, Anthropic list prices in USD per million tokens; check current prices"
  },
  "output": "record.json"
}
