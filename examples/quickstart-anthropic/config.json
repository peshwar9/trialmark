{
  "test_set": "questions.csv",
  "pass_mark": { "metric": "correct", "tolerance_points": 5, "floors": { "grounded": 0.9 }, "choose": "cheapest" },
  "repeats": 3,
  "concurrency": 4,
  "models": [
    {
      "id": "claude-haiku-5-5",
      "runner": "anthropic",
      "settings": {
        "documents": ["contract.md"],
        "system": "Answer from the document only. If it does not contain the answer, say so.",
        "pricing": { "input": 0.1, "output": 0.5 }
      }
    },
    {
      "id": "claude-sonnet-5-5",
      "runner": "anthropic",
      "settings": {
        "documents": ["contract.md"],
        "system": "Answer from the document only. If it does not contain the answer, say so.",
        "pricing": { "input": 2.0, "output": 10.0, "cache_read": 0.2, "cache_write": 2.5 }
      }
    }
  ],
  "scorers": [
    {
      "name": "judge",
      "options": {
        "model": "claude-opus-5-5",
        "documents": ["contract.md"],
        "pricing": { "input": 4.0, "output": 20.0, "cache_read": 0.2, "cache_write": 5.0 }
      }
    }
  ],
  "environment": { "prices_as_of": "5 November 2026, Anthropic list prices in USD per million tokens; check current prices" },
  "output": "record.json"
}
